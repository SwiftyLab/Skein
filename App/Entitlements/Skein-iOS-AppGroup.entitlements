<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the share extension, which drops .torrent files here for
	     the app to collect; an extension's memory limit is too tight to run a
	     libtorrent session itself.

	     Derived from the bundle id so the two targets cannot disagree. Using
	     this file requires App Groups to be enabled for the identifier in your
	     developer account, which is why it is opt-in. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
