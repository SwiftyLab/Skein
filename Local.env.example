# Copy to Local.env and edit. Local.env is gitignored, so your team identifier
# and bundle id stay out of the repository.
#
#   cp Local.env.example Local.env
#
# The TUIST_ prefix is required, not decorative: Tuist evaluates Project.swift
# in a sandbox where only TUIST_-prefixed variables are visible, so these names
# are the only way to reach the manifest.
#
# `make generate` (and every make target that builds an app) loads this file and
# exports it. Running `tuist generate` directly does not — it falls back to the
# defaults in Project.swift. Run `make config` to see what is actually resolved.

# Reverse-DNS bundle identifier for the app. The BGTaskScheduler identifiers and
# the magnet URL type are derived from it, so this one value is enough.
TUIST_BUNDLE_ID=com.example.skein

# Apple Developer Team ID — the ten-character string under Membership at
# developer.apple.com/account. Leave empty for unsigned builds; required to run
# on a device.
TUIST_DEVELOPMENT_TEAM=

# The share extension can hand .torrent files to the app through an app group,
# which needs the App Groups capability enabled for your bundle id in the
# developer account. Off by default so a build never demands that setup —
# magnet links are shared either way. Set to 1 once the capability is enabled.
TUIST_ENABLE_APP_GROUP=

# MARK: - Releasing (alternative distribution only)
#
# Skein is never on the App Store: iOS builds are notarized for EU alternative
# marketplaces (AltStore PAL). See "Releasing" in README.md.

# App Store Connect API key, used by `make upload`, `make listing`,
# `make notarize`, `make status` and `make release`. Create it under App Store
# Connect › Users and Access › Integrations › App Store Connect API › Team Keys
# with the App Manager (or Admin) role.
#
# Shown above the keys list ("Issuer ID"), a UUID.
ASC_ISSUER_ID=
# The key's "Key ID", ten characters.
ASC_KEY_ID=
# Full path to AuthKey_<KeyID>.p8. Keep it outside the repository.
ASC_PRIVATE_KEY_PATH=

# Who publishes Skein and where its pages live. Used for the listing
# (`make listing`: copyright, support and privacy policy URLs) and the AltStore
# source (`make release`: developer name).
DEVELOPER_NAME=
SUPPORT_URL=
PRIVACY_POLICY_URL=

# Review contact for notarization. Apple calls this person if a reviewer has
# questions; never shown publicly. Phone includes the country code.
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_EMAIL=
REVIEW_PHONE=

# AltStore PAL. The Developer ID is in App Store Connect › your name › Edit
# Profile; `make altstore-register` trades it for a marketplace token.
ALTSTORE_DEVELOPER_ID=
ALTSTORE_EMAIL=

# Export compliance. Skein is declared as using standard encryption (OpenSSL,
# BitTorrent protocol encryption) and not distributed in France, so no French
# declaration is needed. Only if `encryption.france` in
# Scripts/appstoreconnect.swift is changed to true: the path to the French
# encryption declaration (ANSSI) PDF.
ENCRYPTION_FRANCE_DOCUMENT=
# The code Apple issues if it approves such a declaration (`make encryption`
# prints it); builds then answer YES with it instead of NO. Not needed otherwise.
TUIST_EXPORT_COMPLIANCE_CODE=
